{
  "name": "flaky-test-casefile",
  "version": "0.1.0",
  "description": "A Playwright reporter that clusters retries into a private static failure casefile.",
  "license": "MIT",
  "homepage": "https://flaky-test-casefile.sociobot.in",
  "repository": { "type": "git", "url": "git+https://github.com/B-Divyesh/sf-flaky-test-casefile.git" },
  "bugs": { "url": "https://github.com/B-Divyesh/sf-flaky-test-casefile/issues" },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./probe": {
      "types": "./dist/probe.d.ts",
      "import": "./dist/probe.js",
      "require": "./dist/probe.cjs"
    }
  },
  "files": [
    "dist/*.js",
    "dist/*.cjs",
    "dist/*.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "keywords": [
    "playwright",
    "reporter",
    "flaky-tests",
    "testing",
    "ci"
  ],
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build:lib": "tsup",
    "build:site": "vite build --config vite.config.ts",
    "build": "npm run build:lib && npm run build:site",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test --config test/e2e/playwright.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "esbuild": "0.25.12"
  }
}
